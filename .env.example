# ─── Invictus Buddy AI — environment ──────────────────────────────────────────
# Copy to .env and fill in ONE provider key to turn on live AI (match
# explanations + icebreakers). With no key, the app runs on its deterministic
# fallback — the demo works fully offline either way.
#
# The key is read ONLY by the dev-server middleware (scripts/ai-middleware.ts).
# It is never bundled into the client / never reaches the browser.

# Option A — OpenAI (you have credit here)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini          # optional, this is the default

# Option B — Anthropic Claude (swap-in alternative; leave OPENAI_API_KEY blank to use this)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # optional, this is the default

# Existing buddy-request backend (unrelated to the AI layer)
# VITE_API_URL=http://localhost:3001
