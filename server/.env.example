# ── Invictus DWH (PostgreSQL 15) ─────────────────────────────────────────────
# Скопируй этот файл в server/.env и заполни DB_PASSWORD.
# Если оставить поля пустыми — сервер запустится в mock-режиме (без DWH).
# ВАЖНО: server/.env добавлен в .gitignore — не коммить credentials.
DB_HOST=
DB_PORT=5432
DB_NAME=master
DB_USER=entryx_report
DB_PASSWORD=
DB_SSL=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
